{"ast":null,"code":"export default {\n  methods: {\n    hello() {\n      alert('Hello H5!');\n    }\n  }\n};","map":{"version":3,"names":["methods","hello","alert"],"sources":["src/App.vue"],"sourcesContent":["<template>\n  <div class=\"h5-page\">\n    <h1>欢迎来到我的H5页面！</h1>\n    <p>这是一个用 Vue 构建的简单 H5 页面。</p>\n    <button @click=\"hello\">点我试试</button>\n  </div>\n</template>\n\n<script>\nexport default {\n  methods: {\n    hello() {\n      alert('Hello H5!');\n    }\n  }\n}\n</script>\n\n<style>\n.h5-page {\n  text-align: center;\n  margin-top: 50px;\n  font-size: 18px;\n}\nbutton {\n  margin-top: 20px;\n  padding: 10px 20px;\n  font-size: 16px;\n}\n</style>"],"mappings":"AASA;EACAA,OAAA;IACAC,MAAA;MACAC,KAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}